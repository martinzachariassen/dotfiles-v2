#!/usr/bin/env bash
#
# `dot` -- the dotfiles CLI.
#
# Usage:
#   dot <command> [options]
#

# `#!/usr/bin/env bash` picks whichever bash comes first on PATH, and macOS
# ships 3.2 (from 2007) as /bin/bash -- so a shell that has not sourced
# Homebrew's shellenv would start this under 3.2 and hit obscure syntax errors
# deep inside the library. Re-exec into the right one instead of failing later.
if ((BASH_VERSINFO[0] < 5)); then
  if [[ -x /opt/homebrew/bin/bash ]]; then
    exec /opt/homebrew/bin/bash "$0" "$@"
  fi
  echo "dot needs bash 5 or newer; this is $BASH_VERSION. Run: brew install bash" >&2
  exit 1
fi

set -euo pipefail

# shellcheck source=../lib/dot.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/dot.sh"

# This is the top level, not somebody's hook. Warnings get reported in the
# Result line and stop there: `dot doctor && ...` must not break because a
# link is orphaned or the repo has uncommitted work. See lib/ui.sh.
__DOT_EXIT_WARN=0

usage() {
  cat <<'EOF'
usage: dot <command> [options]

  apply     Install packages, link config files, run module hooks.
              --dry-run   Show every intended change, make none.
  config    Open the config file in $EDITOR.
              --init      Create it for the first time (runs the wizard).
  doctor    Check this machine. Read-only; never changes anything.

EOF
  # Printed, not baked into the quoted heredoc above: both paths are
  # overridable, and a usage line naming the wrong file is worse than one
  # naming no file at all.
  printf 'Config:  %s\n' "${DOT_CONFIG/#$HOME/\~}"
  printf 'Repo:    %s\n' "${DOT_ROOT/#$HOME/\~}"
  printf 'Remove:  bash uninstall.sh --dry-run   (in the repo; not a verb, on purpose)\n'
}

# --- apply -----------------------------------------------------------------
cmd_apply() {
  # Every option is matched exactly and anything else is fatal. The previous
  # version tested only for --dry-run and ignored the rest, so `dot apply --dry`
  # -- a plausible typo -- silently applied for real.
  while (($#)); do
    case $1 in
      --dry-run) export DOT_DRY_RUN=1 ;;
      *) die "apply: unknown option '$1'. Try: dot apply [--dry-run]" ;;
    esac
    shift
  done

  # Phase 1. Installs dasel and fzf, which everything below depends on, so
  # nothing may run before it.
  heading 'Core packages'
  if ! brew_load; then
    die 'Homebrew is not installed. Run install.sh first.'
  fi
  # Fatal, and explicitly so. Called bare, brew_bundle's `return 1` tripped
  # `set -e` and the ERR trap reported "lib/brew.sh:44: return 1" -- naming the
  # library instead of the one thing worth knowing.
  brew_bundle "$DOT_ROOT/core/Brewfile" core ||
    die 'Core packages did not install. Fix the brew errors above, then re-run.'

  # Config. Generated on first run, read silently ever after -- a tool that
  # re-asks a settled question feels broken.
  if ! cfg_exists; then
    # Not under --dry-run. config_generate declines to write in a dry run, so
    # the wizard would ask five questions and discard every answer -- a preview
    # of a run that cannot happen. And on a machine that has never applied, the
    # fzf check below would then die pointing at "the brew output above" from a
    # phase 1 that was deliberately skipped.
    if [[ $DOT_DRY_RUN == 1 ]]; then
      die "No config at $DOT_CONFIG yet. Create it first: dot config --init"
    fi
    [[ -t 0 ]] ||
      die "No config at $DOT_CONFIG and no terminal to ask. Run: dot config --init"
    command -v fzf >/dev/null ||
      die 'fzf is missing -- phase 1 did not complete. Check the brew output above.'
    wizard_run
  fi

  # Before anything is touched, and in this order: a config dasel gave up on
  # halfway through has no `enabled` key at all, so modules_require_known finds
  # no unknown names and waves it through -- then apply reports "None enabled."
  # and exits 0 over a machine it did nothing to. Refuse instead; the file is
  # not saying what its author thinks it says.
  local problems
  problems=$(cfg_parse_problems)
  [[ -z $problems ]] || die "$DOT_CONFIG did not parse:
    $problems
    edit:       $DOT_CONFIG"

  # Validated here, once, before anything is touched. modules_enabled cannot
  # report this itself: every caller reads it as `< <(modules_enabled)`, and
  # each of those subshells printed its own copy of the complaint.
  modules_require_known

  heading 'Core files'
  fs_link_tree "$DOT_ROOT/core"
  # Folded rather than bare: bare, a warning from core would have exited 2 and
  # `set -e` would have killed the apply before a single module ran.
  fold_status 'core apply.sh failed' "$BASH" "$DOT_ROOT/core/apply.sh"

  # Read into an array first, so "how many were there" is the array's length
  # rather than a counter maintained by hand alongside the loop.
  local name
  local -a names
  mapfile -t names < <(modules_enabled)

  for name in "${names[@]}"; do
    heading "Module: $name"
    module_apply "$name"
  done

  # The expected state after choosing the `none` profile, so say what to do
  # next rather than silently applying core and stopping.
  if ((${#names[@]} == 0)); then
    heading 'Modules'
    say "None enabled. List them under [modules] in $DOT_CONFIG."
  fi

  heading 'Summary'
  fs_report
  [[ $DOT_DRY_RUN == 1 ]] && dim 'Dry run: nothing was changed.'
  return 0
}

# --- config ----------------------------------------------------------------
cmd_config() {
  case ${1:-} in
    --init)
      cfg_exists && die "$DOT_CONFIG already exists. Edit it with: dot config"
      command -v fzf >/dev/null || die 'fzf is missing. Run `dot apply` first.'
      wizard_run
      return 0
      ;;
    '') ;;
    *) die "config: unknown option '$1'. Try: dot config [--init]" ;;
  esac

  cfg_exists || die "No config yet. Create it with: dot config --init"
  # Unquoted, deliberately. $EDITOR conventionally carries arguments -- ours is
  # `code --wait` -- and quoted, bash looks for a binary named "code --wait"
  # and reports "command not found" for a thing that is plainly installed.
  # Splitting on whitespace is what every other $EDITOR consumer does; an
  # editor whose PATH has spaces in it needs a wrapper script, not a rule here.
  # shellcheck disable=SC2086
  ${EDITOR:-vi} "$DOT_CONFIG"
}

# --- doctor ----------------------------------------------------------------
cmd_doctor() {
  cfg_exists || die "No config at $DOT_CONFIG. Run: dot config --init"

  heading 'Core'
  # `fail`, not `warn`: this is exactly what will stop the next `dot apply`,
  # and doctor exists to predict that rather than to shrug at it.
  local unknown
  while IFS= read -r unknown; do
    fail "config lists unknown module '$unknown' -- dot apply will refuse"
  done < <(modules_unknown)

  fold_status 'core checks failed' "$BASH" "$DOT_ROOT/core/doctor.sh"
  fs_check_tree "$DOT_ROOT/core" || fail 'core files are not linked -- run: dot apply'

  # module_doctor tallies its own failures; both of these were `|| true` once.
  local name
  while IFS= read -r name; do
    heading "Module: $name"
    module_doctor "$name"
  done < <(modules_enabled)

  # Links into the repo that no enabled module claims -- left behind by
  # disabling a module or deleting a file. Reported, never deleted: the repo
  # does not get to remove things from your home directory on its own.
  heading 'Orphaned links'
  local orphan found=0
  while IFS= read -r orphan; do
    found=1
    warn "unclaimed  ${orphan/#$HOME/\~}"
  done < <(fs_orphans)
  if ((found)); then
    dim 'Remove with: rm <path>'
  else
    ok 'none'
  fi

  heading 'Result'
  if ((DOT_FAILURES > 0)); then
    # Deliberately not a count. DOT_FAILURES tallies the ✗ lines THIS process
    # printed, and a hook that found three problems arrives as one rolled-up
    # failure -- so "3 problem(s) found" sat underneath five ✗ marks and left
    # you to work out which three. Both branches point rather than count.
    fail 'Problems found -- see the ✗ marks above.'
  elif ((DOT_WARNINGS > 0)); then
    # Neither `ok` nor `fail`. Nothing here will stop the next apply and the
    # exit status stays 0 -- but this line used to read "Everything looks
    # right" directly under a list of orphaned links and a stopped colima.
    warn 'No problems found. There are warnings above worth a look.'
  else
    ok 'Everything looks right.'
  fi
}

# --- dispatch --------------------------------------------------------------
case "${1:-}" in
  apply)
    shift
    cmd_apply "$@"
    ;;
  config)
    shift
    cmd_config "$@"
    ;;
  doctor)
    shift
    cmd_doctor "$@"
    ;;
  -h | --help | help | '')
    usage
    ;;
  *)
    printf 'dot: unknown command %s\n\n' "$1" >&2
    usage >&2
    exit 1
    ;;
esac
