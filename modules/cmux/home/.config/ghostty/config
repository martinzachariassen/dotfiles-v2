# cmux embeds libghostty and reads this file for terminal input behaviour
# (rendering settings only -- cmux's own UI lives in ~/.config/cmux/cmux.json).
#
# Left unset, cmux intercepts Option for Alt/Meta, which swallows the
# Option-letter combos macOS uses for Norwegian AA/AE/OE (aa/ae/oe). Explicit
# `false` keeps Option producing those characters everywhere, same as outside
# the terminal.
macos-option-as-alt = false

# Nerd Font glyphs (statusline icons, git-branch symbol) render as tofu boxes
# without this. "Mono" variant keeps icon glyphs locked to one cell width.
# Installed via: brew install --cask font-jetbrains-mono-nerd-font
font-family = "JetBrainsMono Nerd Font Mono"
