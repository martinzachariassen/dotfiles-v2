# Docker without Docker Desktop.
#
# colima runs dockerd inside a Lima VM and the plain docker CLI talks to it
# over a docker context colima registers itself. No GUI, no licence terms, no
# privileged helper installed into /Library.
#
# colima pulls in lima and qemu as dependencies; they are not listed here
# because Homebrew already guarantees them and a line that repeats a
# dependency is a line that can go stale.

brew "colima"                   # the VM, and the docker daemon inside it
brew "docker"                   # CLI only -- the daemon lives in the VM
brew "docker-buildx"            # plugin; apply.sh links it into ~/.docker
brew "docker-compose"           # plugin; apply.sh links it into ~/.docker
brew "docker-credential-helper" # `docker login` writes to the macOS keychain
