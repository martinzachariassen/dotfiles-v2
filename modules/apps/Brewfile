# GUI apps and fonts. Things with a window or menu bar item; CLIs go in
# dev-cli. A tool whose config this repo manages ships its cask from its own
# module instead (cmux, claude-code).

cask "1password"     # SSH agent and git commit signing
cask "1password-cli" # op; the SSH agent needs the app, not just this
cask "raycast"
cask "claude"
cask "bruno" # API client; local files, no account
cask "google-chrome"
cask "spotify"
cask "visual-studio-code" # $EDITOR (modules/zsh/home/.zshenv) and git's editor

cask "thaw"  # menu bar manager
cask "stats" # resource monitor in the menu bar

# Both builds: the Nerd Font has the glyphs the terminal and starship draw
# with; the plain one keeps editors on stock metrics.
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"
